# CodePlayground Production Environment Variables

# Express Backend Port
PORT=3001

# Neon Postgres Database Connection String
# Example: postgresql://username:password@ep-cool-db-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=your_neon_postgres_connection_string_here

# Frontend API Endpoint (Set in Vercel)
VITE_API_URL=https://codeplayground-backend.onrender.com
